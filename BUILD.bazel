load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("@rules_foreign_cc//foreign_cc:defs.bzl", "configure_make")
# load("@rules_foreign_cc//foreign_cc:defs.bzl", "configure_make")
load("@emsdk//emscripten_toolchain:wasm_rules.bzl", "wasm_cc_binary")

COMMON_FLAGS = "-s USE_PTHREADS=1 -O3"
LDFLAGS_COMMON = "-s USE_PTHREADS=1 -O3"

platform(
    name = "wasm_platform",
    constraint_values = [
        "@platforms//cpu:wasm32",
        "@platforms//os:none",
    ],
)

platform(
    name = "host_platform",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

configure_make(
    name = "libxml2",
    autogen = True,
    configure_in_place = True,
    configure_options = [
        "--enable-static",
        "--disable-shared",
        "--without-python",
        "--without-zlib",
        "--without-lzma",
    ],
    env = {
        # libxml2 probably doesn't support CFI
        # parserInternals.c:3059:31: runtime error: control flow integrity check for type 'void *(unsigned long)' failed during indirect function call
        "CFLAGS": "-fno-sanitize=cfi",
        "CXXFLAGS": "-fno-sanitize=cfi",
        "LDFLAGS": "-fno-sanitize=cfi",
    },
    lib_source = "@libxml2_source//:all_srcs",
    out_static_libs = ["libxml2.a"],
)

cc_library(
    name = "boringssl",
    deps = [
        "@boringssl_source//:ssl",
        "@boringssl_source//:crypto",
    ],
    visibility = ["//visibility:public"],
)

configure_make(
    name = "ffmpeg",
    configure_options = [
        "--disable-debug",
        "--disable-x86asm",
        "--disable-inline-asm",
        "--disable-stripping",
        "--disable-doc",
        "--disable-all",
        "--enable-avcodec",
        "--enable-avformat",
        "--enable-avfilter",
        "--enable-avdevice",
        "--enable-avutil",
        "--enable-swresample",
        "--enable-postproc",
        "--enable-swscale",
        "--enable-decoder=aac,pcm_s16le,mp3",
        "--enable-demuxer=dash,mov,matroska,mp3,webm",
        "--enable-muxer=dash,mp4,webm",
        "--disable-gpl",
    ] + select({
        "@platforms//cpu:wasm32": [
            "--disable-programs",
            "--enable-protocol=file",
            "--target-os=none",
            "--arch=x86_32",
            "--enable-cross-compile",
            "--extra-cflags='%s'" % COMMON_FLAGS,
            "--extra-cxxflags='%s'" % COMMON_FLAGS,
            "--extra-ldflags='%s'" % LDFLAGS_COMMON,
            "--cc=$$EXT_BUILD_ROOT/$(CC)",
            "--cxx=$$EXT_BUILD_ROOT/$(CC)",
            "--ar=$$EXT_BUILD_ROOT/$(AR)",
            "--nm=$$EXT_BUILD_ROOT/$(NM)",
            "--ranlib=:",
            "--as=$$EXT_BUILD_ROOT/$(CC)",
            "--objcc=$$EXT_BUILD_ROOT/$(CC)",
            "--dep-cc=$$EXT_BUILD_ROOT/$(CC)",
        ],
        "//conditions:default": [
            "--enable-ffmpeg",
            "--enable-network",
            "--enable-openssl",
            "--enable-protocol=file,https,tls,tcp,udp",
            "--enable-zlib",
            "--enable-libxml2",
            "--cc=$(CC)",
            "--cxx=$(CC)",
            "--ar=llvm-ar-20",
            "--nm=llvm-nm-20",
            "--ranlib=:",
            "--as=$(CC)",
            "--objcc=$(CC)",
            "--dep-cc=$(CC)",
            "--extra-cflags=-I$$EXT_BUILD_DEPS/boringssl/include",
            "--extra-ldflags=-L$$EXT_BUILD_DEPS/boringssl/lib",
        ],
    }),
    env = select({
        "@platforms//cpu:wasm32": {
            "CFLAGS": COMMON_FLAGS,
            "CXXFLAGS": COMMON_FLAGS,
            "LDFLAGS": LDFLAGS_COMMON,
        },
        "//conditions:default": {},
    }),
    lib_source = "@ffmpeg_source//:all_srcs",
    out_binaries = select({
        "@platforms//cpu:wasm32": [],
        "//conditions:default": ["ffmpeg"],
    }),
    out_static_libs = [
        "libavdevice.a",
        "libavfilter.a",
        "libavformat.a",
        "libavcodec.a",
        "libswscale.a",
        "libswresample.a",
        "libavutil.a",
    ],
    deps = [":libxml2", ":boringssl"],
)

cc_library(
    name = "ikaria_lib",
    srcs = glob(["src/*.cpp"]),
    hdrs = glob(["src/*.hpp"]),
    alwayslink = 1,
    copts = select({
        "@platforms//cpu:wasm32": [
            "-s USE_PTHREADS=1",
            # Nested Workerにするとバンドラーが正しくバンドルできないのでJSPIを使いたい
            # Firefoxが対応していないので見送り
            # "-sJSPI",
            "-sNO_DISABLE_EXCEPTION_CATCHING",
            "-O3",
            "-fexceptions",
        ],
        "//conditions:default": ["-O3", "-pthread"],
    }),
    includes = ["src"],
    deps = [":ffmpeg"],
    linkopts = select({
        "@platforms//cpu:wasm32": [],
        "//conditions:default": [
            "-lz",
            "-lm",
            "-lpthread",
            "-ldl",
        ],
    }),
)

cc_binary(
    name = "ikaria",
    linkopts = [
        "-O3",
        "--bind",
        "-sNO_DISABLE_EXCEPTION_CATCHING",
        "-sINITIAL_MEMORY=399966208",
        "-sALLOW_MEMORY_GROWTH=1",
        "-sEXPORT_ES6=1",
        "-sWASMFS",
        "-sASSERTIONS",
        "-sPTHREAD_POOL_SIZE=navigator.hardwareConcurrency",
        "-pthread",
        "-o ikaria.js",
    ],
    deps = [":ikaria_lib"],
)

wasm_cc_binary(
    name = "ikaria_js",
    cc_target = ":ikaria",
    outputs = ["ikaria.js", "ikaria.wasm"],
)

configure_make(
    name = "curl",
    autogen = False,
    configure_in_place = True,
    configure_command = "configure",
    configure_prefix = " ".join([
        "ln -sf $$EXT_BUILD_DEPS/lib/libcrypto_internal.a $$EXT_BUILD_DEPS/lib/libcrypto.a &&",
        "ln -sf $$EXT_BUILD_DEPS/lib/libssl_internal.a $$EXT_BUILD_DEPS/lib/libssl.a &&",
        " &&",
    ]),
    configure_options = [
        "--disable-shared",
        "--enable-static",
        "--with-openssl",
        "--with-pic",
        "--without-libpsl",
        "--disable-ldap",
        "--disable-rtsp",
        "--disable-proxy",
    ],
    lib_source = "@curl_source//:all_srcs",
    env = {
        "CPPFLAGS": "-I$$EXT_BUILD_DEPS/include",
        "LDFLAGS": "-L$$EXT_BUILD_DEPS/lib",
        "OPENSSL_LIBS": "-L$$EXT_BUILD_DEPS/lib -lssl_internal -lcrypto_internal -ldl -lpthread",
        "LIBS": "-ldl -lpthread",
    },
    out_static_libs = ["libcurl.a"],
    deps = [":boringssl"],
)

cc_library(
    name = "test_utils",
    srcs = ["tests/utils.cpp"],
    hdrs = ["tests/utils.hpp"],
    deps = [
        ":ikaria_lib",
        ":curl",
        "@googletest//:gtest",
    ],
)

cc_test(
    name = "test_dash_remuxer",
    srcs = ["tests/dash_test.cpp"],
    data = glob(["tests/test_data/*"]),
    tags = ["exclusive"],
    deps = [
        ":ikaria_lib",
        ":test_utils",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "test_dash_remuxer_with_ffmpeg",
    srcs = ["tests/dash_test_ffmpeg.cpp"],
    data = glob(["tests/test_data/*"]),
    tags = ["exclusive"], # 他のテストと同時に実行されないようにする
    deps = [
        ":ikaria_lib",
        ":test_utils",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "test_compiler_is_clang_not_gcc",
    srcs = ["tests/check_compiler.cpp"],
    deps = [
        ":ikaria_lib",
        ":test_utils",
        "@googletest//:gtest_main",
    ],
)
